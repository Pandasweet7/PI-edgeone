{
  "name": "pi-web-makers",
  "version": "0.1.0",
  "private": true,
  "description": "PI Coding Agent with its official PI WEB UI on EdgeOne Makers. The browser loads the PI WEB client; Makers hosts the static assets, agent routes, AI gateway, sidecar processes, snapshot store, and BYOK environment secrets.",
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "type": "module",
  "scripts": {
    "prepare:pi-web": "node scripts/prepare-pi-web.mjs",
    "prepare:packages": "node scripts/prepare-packages.mjs",
    "build": "npm run prepare:pi-web",
    "build:makers": "npm run prepare:pi-web && node scripts/prune-agent-node.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.1",
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@fastify/compress": "^9.0.0",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.3.0",
    "@jmfederico/pi-web": "^1.202608.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "fastify": "^5.10.0",
    "lit": "^3.3.3",
    "marked": "^18.0.6",
    "node-pty": "^1.1.0",
    "typebox": "1.3.7",
    "undici": "^8.5.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.0"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "^1.3.2",
    "@img/sharp-linux-x64": "^0.35.3",
    "@koromix/koffi-linux-x64": "^3.1.5"
  }
}
