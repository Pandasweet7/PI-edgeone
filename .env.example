# ── EdgeOne Makers Models (required) ─────────────────────────────────────
# Create a key at Makers → Models → API Key and paste it here.
AI_GATEWAY_API_KEY=
# Default: https://ai-gateway.edgeone.link/v1
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1
# Default: @makers/deepseek-v4-flash (free built-in model)
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# ── BYOK: bring your own keys (optional) ─────────────────────────────────
# Keys are only ever read from the deployment environment and forwarded to the
# pi agent processes. They are NOT stored in the web UI, NOT written to files,
# and NOT persisted in the conversation store. Set any subset here; the model
# picker in PI WEB will list the corresponding providers automatically.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
FIREWORKS_API_KEY=
TOGETHER_API_KEY=
BASETEN_API_KEY=
KIMI_API_KEY=
MINIMAX_API_KEY=
NVIDIA_API_KEY=
CLOUDFLARE_API_KEY=
AZURE_OPENAI_API_KEY=
