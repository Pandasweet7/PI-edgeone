{
  "installCommand": "npm ci",
  "buildCommand": "npm run build:makers",
  "outputDirectory": "dist",
  "nodeVersion": "24",
  "agents": {
    "framework": "openai-sdk",
    "timeout": 600,
    "externalNodeModules": [
      "@jmfederico/pi-web",
      "@earendil-works/pi-coding-agent",
      "@earendil-works/pi-agent-core",
      "@earendil-works/pi-ai",
      "node-pty",
      "fastify",
      "@fastify/compress",
      "@fastify/static",
      "@fastify/websocket",
      "ws",
      "undici",
      "lit",
      "marked",
      "diff",
      "typebox"
    ],
    "sandbox": {
      "timeout": 300
    }
  }
}
